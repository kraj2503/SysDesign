# SysDesignLab systemd unit — managed by deploy/deploy.sh.
# Runs the Express API (tsx) which also serves the built client in production.
[Unit]
Description=SysDesignLab API + client
After=network.target

[Service]
Type=simple
User=sysdesignlab
Group=sysdesignlab
WorkingDirectory=/opt/sysdesignlab/server
# env.ts loads /opt/sysdesignlab/.env from the repo root (one level up from server/)
Environment=NODE_ENV=production
# npm workspaces hoist tsx to the ROOT node_modules/.bin (server/node_modules doesn't exist)
ExecStart=/opt/sysdesignlab/node_modules/.bin/tsx src/index.ts
Restart=always
RestartSec=3

# Hardening. Keep this block minimal: the previous PrivateTmp/ProtectSystem/
# ReadWritePaths options made the unit die at the NAMESPACE step with ENOENT when
# /opt/sysdesignlab/server/data was absent. /opt is NOT covered by
# ProtectSystem=full, so ReadWritePaths there was a no-op anyway, and the app
# creates server/data itself (db.ts mkdirSync). Add namespace options back one
# at a time and verify with: systemctl restart sysdesignlab && systemctl status
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
