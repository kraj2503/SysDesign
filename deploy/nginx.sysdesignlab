# SysDesignLab nginx site — proxies everything to the Express app (single origin).
# Express serves the built client + SPA fallback + /api in production.
#
# HTTPS note: when you add a domain, run certbot (see deploy/ORACLE.md) and it will
# rewrite this file to add a listen 443 ssl block. The app's auth cookie then becomes
# Secure automatically because it sees X-Forwarded-Proto: https.
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;

  # Import accepts JSON/CSV payloads up to 10MB (matches express.json limit).
  client_max_body_size 10m;

  location / {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
}
