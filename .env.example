# SysDesignLab environment variables
# Copy this file to `.env` at the project root and fill in real values.

# Port for the Express API (Vite dev client always uses :5173)
PORT=4000

# Session/JWT signing secret. REQUIRED in production (NODE_ENV=production).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# "production" enables serving the built client (client/dist) from the API on one origin.
NODE_ENV=development

# --- Google OAuth (optional — needed for "Sign in with Google") ---
# Create a project at https://console.cloud.google.com/ and add an OAuth client
# (Web application). Set the Authorized redirect URI to:
#   http://localhost:4000/api/auth/google/callback  (dev)
#   https://your-domain.com/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
