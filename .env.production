# SysDesignLab — Production Environment
# Copy this to .env on the server and fill in real values.
# NEVER commit real secrets to git.

# ─────────────────────────────────────────────────────────────────
# REQUIRED — the app will NOT start without these in production
# ─────────────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Must be "production" for the API to serve the built client + enable Secure cookies + HSTS
NODE_ENV=production

# Port the Express API listens on (nginx proxies 80/443 → this port)
PORT=4000

# ─────────────────────────────────────────────────────────────────
# OPTIONAL — Google OAuth (enable "Sign in with Google" button)
# ─────────────────────────────────────────────────────────────────
# 1. Create a project at https://console.cloud.google.com/
# 2. APIs & Services → Credentials → Create Credentials → OAuth client ID (Web application)
# 3. Authorized redirect URI: https://your-domain.com/api/auth/google/callback
# 4. Fill in below:

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# ─────────────────────────────────────────────────────────────────
# OPTIONAL — CORS (only needed if you serve client from a different origin)
# ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In single-origin deploy (this setup), nginx proxies everything so same-origin
# requests have no Origin header and are automatically allowed.
# Only set this if you split client/server across domains.
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# ─────────────────────────────────────────────────────────────────
# OPTIONAL — Database path (default is fine for single-server deploy)
# ─────────────────────────────────────────────────────────────────
# DB_PATH=/opt/sysdesignlab/server/data/sysdesign.db